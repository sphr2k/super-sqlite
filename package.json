{
  "name": "supersqlite",
  "version": "1.0.0",
  "description": "Typed JSON documents on SQLite with SuperJSON, typed schemas and indexes",
  "main": "./dist/index.js",
  "scripts": {
    "test": "vp test",
    "start": "bun run build && node dist/demo.js",
    "ecommerce:seed": "bun run build && node dist/seed-benchmark.js",
    "ecommerce:bench": "bun run build && node dist/benchmark.js",
    "typecheck": "bun check",
    "infer": "vp exec src/cli.ts infer",
    "build": "tsc",
    "smoke": "node scripts/package-smoke.mjs",
    "bench:projection": "bun run build && node benchmarks/projections.mjs",
    "prepare": "npm run build",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "verify": "bun check && vp lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "arktype": "^2.1.29",
    "drizzle-orm": "^0.45.1",
    "superjson": "^2.2.6",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@faker-js/faker": "^10.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.10",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.8",
    "miniflare": "^4.20260730.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite-plus": "1.5.1",
    "zod": "^4.6"
  },
  "bin": {
    "super-sqlite": "./dist/cli.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./d1": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "default": "./dist/factory.js"
    },
    "./adapters/d1": {
      "types": "./dist/adapters/d1.d.ts",
      "default": "./dist/adapters/d1.js"
    },
    "./adapters/better-sqlite3": {
      "types": "./dist/adapters/better-sqlite3.d.ts",
      "default": "./dist/adapters/better-sqlite3.js"
    },
    "./package.json": "./package.json",
    "./do": {
      "types": "./dist/durable-object.d.ts",
      "default": "./dist/durable-object.js"
    },
    "./adapters/durable-object": {
      "types": "./dist/adapters/durable-object.d.ts",
      "default": "./dist/adapters/durable-object.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "peerDependencies": {
    "better-sqlite3": "^12.6.2",
    "zod": "^4.6"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "@jridgewell/sourcemap-codec": "1.6.0"
  },
  "packageManager": "bun@1.4.3"
}
